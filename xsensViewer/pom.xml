<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.jamdev</groupId>
	<artifactId>xsensViewer</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<description>Views sensor data via serial from attached devices</description>

	<properties>
		<!-- Kept in step with the SoundNet Firmware Updater, so both applications
		     render the Transit theme identically. Transit 2.0.0 is compiled for
		     Java 17 and built against JavaFX 22. -->
		<maven.compiler.release>17</maven.compiler.release>
		<javafx.version>22.0.2</javafx.version>
		<transit.version>2.0.0</transit.version>
		<controlsfx.version>11.2.1</controlsfx.version>

		<!-- Shown in Add/Remove Programs and stamped into the launcher. This
		     cannot be ${project.version}: jpackage takes one to three integers
		     separated by dots, so it rejects both the "-SNAPSHOT" suffix and a
		     leading zero ("the first number in an app-version cannot be zero").
		     Bump this when cutting a release. -->
		<app.version>1.0.0</app.version>
		<app.name>SoundNet Sensor Viewer</app.name>
		<app.main.class>main.SensorMainLauncher</app.main.class>
	</properties>


	<repositories>
		<!--  Project repo to hold the custom jar files that are not available in Maven.  Do
		this so that we don't have to do the extra step of manually installing jar files in the local repo -->
		<repository>
			<id>repo</id>
			<releases>
				<enabled>true</enabled>
				<checksumPolicy>ignore</checksumPolicy>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<url>file://${project.basedir}/repo</url>
		</repository>
	</repositories>


	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.11</version>
			<scope>test</scope>
		</dependency>
		
		
		
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<!-- fxyz3d drags in JavaFX 15 (including its x86 mac natives, which are
		     the wrong ones on Apple silicon). Declaring every module we need at
		     ${javafx.version} and excluding fxyz3d's below keeps exactly one
		     JavaFX on the classpath. -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-base</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-fxml</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-swing</artifactId>
			<version>${javafx.version}</version>
		</dependency>

		<!-- https://mvnrepository.com/artifact/org.jfxtras/jmetro -->
		<dependency>
			<groupId>org.interactivemesh</groupId>
			<artifactId>stl</artifactId>
			<version>1.0.0</version>
		</dependency>


		<!-- Transit theme (GPLv2 with Classpath Exception, so linking is fine
		     here). Replaces JMetro, which is the same author's earlier theme.
		     Pulls in FXSkins and fxthemes transitively. -->
		<dependency>
			<groupId>com.pixelduke</groupId>
			<artifactId>transit</artifactId>
			<version>${transit.version}</version>
			<exclusions>
				<!-- Transit and ControlsFX both declare their own JavaFX. Letting
				     those onto the classpath alongside the JavaFX declared above
				     mixes two runtimes and ships the wrong platform's natives. -->
				<exclusion>
					<groupId>org.openjfx</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- https://mvnrepository.com/artifact/org.apache.commons/commons-math3 -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-math3</artifactId>
			<version>3.6.1</version>
		</dependency>

		<!-- https://mvnrepository.com/artifact/com.fazecast/jSerialComm -->
		<dependency>
			<groupId>com.fazecast</groupId>
			<artifactId>jSerialComm</artifactId>
			<version>2.9.2</version>
		</dependency>

		<dependency>
			<groupId>io.github.typhon0</groupId>
			<artifactId>AnimateFX</artifactId>
			<version>1.2.3</version>
		</dependency>


		<dependency>
			<groupId>org.fxyz3d</groupId>
			<artifactId>fxyz3d</artifactId>
			<version>0.5.4</version>
			<exclusions>
				<exclusion>
					<groupId>org.openjfx</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>


		<dependency>
			<groupId>org.fxyz3d</groupId>
			<artifactId>fxyz-importers</artifactId>
			<version>0.5.3</version>
			<exclusions>
				<exclusion>
					<groupId>org.openjfx</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		
		<!-- ToggleSwitch, used for the dark-mode switch. -->
		<dependency>
		    <groupId>org.controlsfx</groupId>
		    <artifactId>controlsfx</artifactId>
		    <version>${controlsfx.version}</version>
		    <exclusions>
		        <exclusion>
		            <groupId>org.openjfx</groupId>
		            <artifactId>*</artifactId>
		        </exclusion>
		    </exclusions>
		</dependency>



	</dependencies>

	<!-- jpackage is not a cross-compiler: a Windows build can only be produced
	     on Windows. This profile therefore only switches itself on there, and
	     runs as part of an ordinary "mvn package". -->
	<profiles>
		<profile>
			<id>win</id>
			<activation><os><family>windows</family></os></activation>
			<build>
				<plugins>
					<!-- Turns the staged app in target/app into self-contained builds
					     with their own bundled JRE, so a researcher never needs to
					     install Java.

					     app-image is a *folder* (target/dist/app-image/...): the .exe
					     launcher inside it is only a few hundred KB because it is
					     just a native stub that loads the JVM from the "runtime"
					     folder sitting next to it - the whole folder must be kept
					     together, the .exe cannot be copied out on its own.

					     For a single .exe file that actually contains the JRE,
					     jpackage's own "exe" type builds a proper installer
					     directly (no custom script needed): on Windows this shells
					     out to the WiX Toolset v3 (candle.exe/light.exe, which ship
					     with the Burn bootstrapper backend the "exe" jpackage
					     type needs) - https://wixtoolset.org/, e.g. choco install
					     wixtoolset, version 3.14.1. That installer is large
					     (100+ MB) and installs under the user's own profile with
					     its own copy of the JRE (win-per-user-install: no
					     administrator rights, no UAC prompt). If WiX is not
					     available the step is skipped
					     with a warning rather than failing the build; the
					     app-image folder is produced either way. -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>3.1.0</version>
						<executions>
							<execution>
								<id>jpackage-app-image</id>
								<phase>package</phase>
								<goals><goal>run</goal></goals>
								<configuration>
									<target>
										<delete dir="${project.build.directory}/dist" quiet="true"/>
										<!-- ${java.home} is the JDK running this Maven build, so
										     this does not depend on jpackage being on PATH
										     (java.home may be a JRE-only install, e.g. Eclipse's
										     bundled runtime, in which case this step fails -
										     build with a full JDK 17+ on JAVA_HOME instead). -->
										<exec executable="${java.home}/bin/jpackage" failonerror="true">
											<arg value="--type"/>
											<arg value="app-image"/>
											<arg value="--name"/>
											<arg value="${app.name}"/>
											<arg value="--app-version"/>
											<arg value="${app.version}"/>
											<arg value="--vendor"/>
											<arg value="SoundNet"/>
											<arg value="--input"/>
											<arg value="${project.build.directory}/app"/>
											<arg value="--main-jar"/>
											<arg value="${project.build.finalName}.jar"/>
											<arg value="--main-class"/>
											<arg value="${app.main.class}"/>
											<!-- Without this, jpackage runs jdeps against the
											     app's jars to guess which JDK modules the
											     bundled/jlinked runtime needs, and trims out
											     anything it doesn't see referenced statically.
											     JavaFX's internal pipeline, ControlsFX, Transit,
											     AnimateFX and fxyz3d all reach modules via
											     reflection/ServiceLoader that jdeps can't see, so
											     the trimmed runtime can be missing something
											     needed at startup - which shows up as exactly a
											     flash of the splash screen followed by a native
											     "JVM failed to launch" dialog, since the
											     JLI_Launch call fails before any application code
											     runs. Ask for every JDK module instead of
											     guessing. -->
											<arg value="--add-modules"/>
											<arg value="ALL-MODULE-PATH"/>
											<!-- Icon for the generated launcher .exe. -->
											<arg value="--icon"/>
											<arg value="${project.basedir}/packaging/icon.ico"/>
											<arg value="--dest"/>
											<arg value="${project.build.directory}/dist/app-image"/>
										</exec>
									</target>
								</configuration>
							</execution>
							<execution>
								<id>wix-exe-installer</id>
								<phase>package</phase>
								<goals><goal>run</goal></goals>
								<configuration>
									<target>
										<mkdir dir="${project.build.directory}/dist/installer"/>
										<property environment="env"/>
										<!-- Work out candle.exe/light.exe's folder so jpackage
										     can find them even if PATH has not been refreshed
										     since WiX was installed. The WiX installer sets the
										     WIX env var to its install root (trailing backslash
										     included), which is the most version-proof source;
										     the hard-coded folder is a fallback for older
										     installs. -->
										<condition property="wix.bindir" value="${env.WIX}bin">
											<isset property="env.WIX"/>
										</condition>
										<condition property="wix.bindir"
										           value="C:\Program Files (x86)\WiX Toolset v3.14\bin">
											<available file="C:\Program Files (x86)\WiX Toolset v3.14\bin\candle.exe"/>
										</condition>
										<condition property="wix.bindir" value="">
											<not><isset property="wix.bindir"/></not>
										</condition>
										<!-- Windows names its PATH variable "Path" or "PATH"
										     depending on the machine; read whichever exists. -->
										<condition property="path.current" value="${env.Path}">
											<isset property="env.Path"/>
										</condition>
										<condition property="path.current" value="${env.PATH}">
											<isset property="env.PATH"/>
										</condition>
										<condition property="path.current" value="">
											<not><or><isset property="env.Path"/><isset property="env.PATH"/></or></not>
										</condition>
										<!-- failonerror covers jpackage running and returning a
										     non-zero exit code; failifexecutionfails covers
										     jpackage not being runnable at all - Ant treats that
										     as a hard build failure by default whatever
										     failonerror says. -->
										<exec executable="${java.home}/bin/jpackage" failonerror="false" failifexecutionfails="false"
										      resultproperty="wix.exit" outputproperty="wix.out" errorproperty="wix.err">
											<!-- Ant's environment merge is case-insensitive on
											     Windows, so setting "Path" here correctly
											     overrides whichever case the inherited variable
											     actually used. -->
											<env key="Path" value="${wix.bindir}${path.separator}${path.current}"/>
											<arg value="--type"/>
											<arg value="exe"/>
											<arg value="--name"/>
											<arg value="${app.name}"/>
											<arg value="--app-version"/>
											<arg value="${app.version}"/>
											<arg value="--vendor"/>
											<arg value="SoundNet"/>
											<arg value="--input"/>
											<arg value="${project.build.directory}/app"/>
											<arg value="--main-jar"/>
											<arg value="${project.build.finalName}.jar"/>
											<arg value="--main-class"/>
											<arg value="${app.main.class}"/>
											<!-- See the matching comment on the app-image
											     execution above: without this, the jlinked
											     runtime jpackage builds can end up missing a
											     module the app needs at startup, which manifests
											     as the splash flashing and then a native "JVM
											     failed to launch" dialog. -->
											<arg value="--add-modules"/>
											<arg value="ALL-MODULE-PATH"/>
											<arg value="--icon"/>
											<arg value="${project.basedir}/packaging/icon.ico"/>
											<!-- Per-user install: no administrator rights, no UAC prompt. -->
											<arg value="--win-per-user-install"/>
											<arg value="--win-shortcut"/>
											<arg value="--win-menu"/>
											<arg value="--win-dir-chooser"/>
											<arg value="--dest"/>
											<arg value="${project.build.directory}/dist/installer"/>
										</exec>
										<condition property="wix.message"
										           value="WiX installer built: ${project.build.directory}/dist/installer">
											<equals arg1="${wix.exit}" arg2="0"/>
										</condition>
										<condition property="wix.message"
										           value="WARNING: could not build the single-file installer .exe (needs WiX Toolset v3 on PATH or at its default install location - choco install wixtoolset --version=3.14.1, then restart your terminal/IDE so PATH refreshes). The self-contained app-image folder in target/dist/app-image is still available. jpackage output was:${line.separator}${wix.out}${line.separator}${wix.err}">
											<not><equals arg1="${wix.exit}" arg2="0"/></not>
										</condition>
										<echo message="${wix.message}"/>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<!-- A stable, version-free jar name, so the packaging steps here and in
		     .github/workflows/release.yml can name it without tracking the
		     project version. Matches how the firmware updater is built. -->
		<finalName>xsensviewer</finalName>
		<sourceDirectory>src</sourceDirectory>
		<resources>
			<resource>
				<directory>src</directory>
				<excludes>
					<exclude>**/*.java</exclude>
					<!-- Vendored copies of libraries Maven now supplies. A jar nested
					     inside a jar is not on the classpath anyway, so these were
					     only ever dead weight - and src/jars/jmetro-5.5.jar is a
					     theme this application no longer uses. -->
					<exclude>jars/**</exclude>
					<exclude>**/.DS_Store</exclude>
				</excludes>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.openjfx</groupId>
				<artifactId>javafx-maven-plugin</artifactId>
				<version>0.0.8</version>
				<configuration>
					<mainClass>${app.main.class}</mainClass>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>${maven.compiler.release}</source>
					<target>${maven.compiler.release}</target>
					<release>${maven.compiler.release}</release>
					<!-- -The bit below prevents jar from being implemented -->
					<!-- <compilerId>jdt</compilerId> <compilerArguments> <properties>.settings/org.eclipse.jdt.core.prefs</properties> 
						make sure to use same params as what Eclipse uses </compilerArguments> -->
				</configuration>
			</plugin>

			<plugin>
				<!-- Build an executable JAR -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>true</addClasspath>
							<classpathPrefix>lib/</classpathPrefix>
							<mainClass>${app.main.class}</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>


			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.4.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<!-- Attach the fat jar as ...-all.jar instead of replacing
							     the main artifact. jpackage needs the plain thin jar
							     next to target/app/lib; the fat jar stays available
							     for anyone who just wants "java -jar". -->
							<shadedArtifactAttached>true</shadedArtifactAttached>
							<shadedClassifierName>all</shadedClassifierName>
							<transformers>
								<!-- fxyz3d's importers are discovered through
								     META-INF/services; without this the entries from
								     the different jars overwrite each other. -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>${app.main.class}</mainClass>
								</transformer>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>module-info.class</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Collect every dependency next to the jar so jpackage can consume
			     the whole directory as a classpath app-image. Mirrors the layout
			     the SoundNet Firmware Updater builds. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.6.1</version>
				<executions>
					<execution>
						<id>copy-deps</id>
						<phase>package</phase>
						<goals><goal>copy-dependencies</goal></goals>
						<configuration>
							<outputDirectory>${project.build.directory}/app/lib</outputDirectory>
							<includeScope>runtime</includeScope>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>stage-jar</id>
						<phase>package</phase>
						<goals><goal>run</goal></goals>
						<configuration>
							<target>
								<copy file="${project.build.directory}/${project.build.finalName}.jar"
								      todir="${project.build.directory}/app"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.2.1</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<!-- <source>8</source> <detectJavaApiLink>false</detectJavaApiLink> -->
					<failOnError>false</failOnError>
				</configuration>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>

	</build>
</project>